        ],
        "medicine": "硫磺悬浮剂500倍、三唑酮1500倍",
        "organic": "小苏打水（5g:1L）喷雾、牛奶水（1:9）喷雾",
        "spray_interval": "5-7天1次，连续3次",
        "prevention": "增加光照，避免过度密植"
      }
    },
    {
      "id": "gray_mold",
      "name": "灰霉病",
      "keywords": ["灰霉", "灰色", "霉层", "发霉"],
      "plant_types": ["all"],
      "symptoms": "叶片、花朵出现灰色霉层，潮湿环境多发",
      "urgency": "high",
      "contagious": true,
      "solution": {
        "steps": [
          "清除所有病组织",
          "降低湿度，加强通风",
          "避免叶面喷水"
        ],
        "medicine": "嘧霉胺1000倍、腐霉利1500倍",
        "spray_interval": "5天1次，连续3次",
        "prevention": "控制浇水，保持通风，避免低温高湿"
      }
    },
    {
      "id": "root_rot_disease",
      "name": "根腐病",
      "keywords": ["根腐", "烂根", "根黑", "根烂"],
      "plant_types": ["all"],
      "symptoms": "根部变黑腐烂，植株萎蔫，土壤有臭味",
      "urgency": "high",
      "contagious": false,
      "solution": {
        "steps": [
          "脱盆清洗根系",
