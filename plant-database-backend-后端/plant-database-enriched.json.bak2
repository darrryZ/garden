    {
      "id": "p001",
      "name": "绿萝",
      "scientificName": "Epipremnum aureum",
      "category": "foliage",
      "family": "天南星科",
      "origin": "所罗门群岛",
      "difficulty": 1,
      "light": 2,
      "water": "medium",
      "temperature": "18-28°C",
      "humidity": "40-70%",
      "soil": "疏松透气",
      "fertilizer": "生长期每月一次",
      "growthRate": "快",
      "matureSize": "",
      "toxicity": "对宠物有毒",
      "propagation": "扦插、分株",
      "description": "绿萝是天南星科麒麟叶属的常绿藤本植物，叶片呈心形，色泽翠绿，具有极强的生命力。它是最受欢迎的室内观叶植物之一，因其易于养护和优秀的空气净化能力而备受青睐。",
      "careTips": [
        "💧 浇水原则：见干见湿，手指插入土中2-3厘米感觉干燥再浇水",
        "☀️ 光照调节：长期阴暗会导致叶片变小、颜色变淡，需适当补光",
        "🌡️ 温度注意：冬季远离暖气片和空调出风口，避免叶片干枯",
        "💨 通风重要：保持良好通风可预防病虫害，但避免强风直吹",
        "🧹 清洁叶片：定期用湿布擦拭叶片，保持光合作用效率",
        "🪴 换盆时机：每年春季换盆一次，选择比原盆大一号的花盆",
        "✂️ 繁殖技巧：水培扦插生根快，剪取带气根的茎段插入水中即可"
      ],
      "commonIssues": [
        "黄叶：浇水不当",
        "徒长：光照不足",
        "病虫害：注意通风"
      ],
      "tags": [
        "新手友好",
        "耐阴",
        "净化空气"
      ],
      "image": "https://images.unsplash.com/photo-1596724857861-9b5b97c5ec0c?w=400",
      "symbolism": "守望幸福，坚韧不屈。绿萝象征着顽强的生命力和对未来的希望，寓意着即使在逆境中也能茁壮成长。",
      "careGuide": {
        "light": "喜欢明亮的散射光，避免强烈阳光直射。可放置在室内光线明亮的窗边或离窗2-3米处。夏季需遮阴，冬季可适当增加光照。",
        "water": "保持土壤微湿，表土干燥时浇水。夏季每周1-2次，冬季每10-15天一次。避免积水，防止烂根。",
        "temperature": "适宜温度18-28°C，冬季不低于10°C。避免冷风直吹和温度骤变。",
        "humidity": "喜欢湿润环境，湿度40-70%为宜。可定期喷雾增加湿度，尤其在干燥的冬季。",
        "soil": "疏松、透气、排水良好的土壤。可用腐叶土、园土、河沙按2:2:1混合。",
        "fertilizer": "生长期（春夏季）每2周施一次稀释的液肥，秋冬季减少或停止施肥。",
        "pruning": "定期修剪过长枝条，促进分枝，保持株型美观。剪下的枝条可用于扦插繁殖。"
      }
    },
