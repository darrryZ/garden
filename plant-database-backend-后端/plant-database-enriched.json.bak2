      "name": "迷迭香",
      "scientificName": "Rosmarinus officinalis",
      "category": "herb",
      "family": "唇形科",
      "origin": "地中海",
      "difficulty": 3,
      "light": 3,
      "water": "medium",
      "temperature": "18-28°C",
      "humidity": "40-70%",
      "soil": "疏松透气",
      "fertilizer": "生长期每月一次",
      "growthRate": "中等",
      "matureSize": "",
      "toxicity": "未知",
      "propagation": "扦插、分株",
      "description": "迷迭香是唇形科植物，原产于地中海。芳香怡人，既可观赏又可食用，是实用的香草植物。养护难度中等，适合有一定经验的植物爱好者种植。",
      "careTips": [
        "💧 浇水前用手指测试土壤湿度，避免过度浇水",
        "☀️ 定期转动花盆，让植物各面均匀接受光照",
        "🌡️ 注意季节变化，及时调整养护方式",
        "💨 保持良好通风，预防病虫害发生",
        "🧹 定期清洁叶片，保持光合作用效率",
        "🪴 选择合适的花盆，确保有良好的排水性",
        "🌱 观察植物状态，及时发现并解决问题"
      ],
      "commonIssues": [
        "黄叶：浇水不当",
        "叶尖干枯：空气太干燥",
        "病虫害：注意通风"
      ],
      "tags": [],
      "image": "https://images.unsplash.com/photo-1562690868-60bbe7293e94?w=400",
      "symbolism": "迷迭香象征着坚韧与顽强，寓意在逆境中依然茁壮成长。",
      "careGuide": {
        "light": "放置在明亮的散射光处，避免强烈阳光直射。根据植物特性调整光照强度。",
        "water": "根据土壤干湿程度浇水，保持土壤微湿但不积水。不同季节调整浇水频率。",
        "temperature": "保持适宜温度，避免极端高温或低温。冬季注意防寒保暖。",
        "humidity": "保持适当空气湿度，干燥季节可适当喷雾增加湿度。",
        "soil": "使用疏松、透气、排水良好的营养土。定期松土保持土壤透气性。",
        "fertilizer": "生长期定期施肥，使用稀释的液肥或缓释肥。冬季减少或停止施肥。",
        "pruning": "及时剪除枯黄叶片和枝条，保持株型美观，促进新枝生长。"
      }
    },
