    {
      "id": "p073",
      "name": "桂花",
      "scientificName": "Osmanthus fragrans",
      "category": "flowering",
      "family": "木犀科",
      "origin": "中国",
      "difficulty": 2,
      "light": 4,
      "water": "medium",
      "temperature": "18-28°C",
      "humidity": "40-70%",
      "soil": "疏松透气",
      "fertilizer": "生长期每月一次",
      "growthRate": "中等",
      "matureSize": "",
      "toxicity": "未知",
      "propagation": "扦插、分株",
      "description": "桂花（学名：Osmanthus fragrans），属于木犀科，原产于中国，是室内绿植。适合室内环境的绿色植物，净化空气，美化环境，提升生活品质。非常容易养护，半日照环境，中等养护。叶片形态优美，观赏价值高，是新手入门的理想选择。",
      "careTips": [
        "☀️ 避免正午烈日，可搭建遮阳网保护叶片",
        "💧 见干见湿，浇则浇透，避免半截水",
        "🌡️ 远离空调出风口和暖气片，避免温度骤变",
        "💨 保持良好通风，预防病虫害发生",
        "🧹 定期用湿布擦拭叶片，保持光合作用效率",
        "🪴 每年春季换盆一次，选择稍大一号的花盆",
        "✂️ 及时剪除枯黄叶片，促进新枝萌发"
      ],
      "commonIssues": [
        "黄叶：浇水不当",
        "叶尖干枯：空气太干燥",
        "病虫害：注意通风"
      ],
      "tags": [
        "观花"
      ],
      "image": "https://images.unsplash.com/photo-1562690868-60bbe7293e94?w=400",
      "symbolism": "象征着健康与和谐，寓意家庭温馨，生活安宁。",
      "careGuide": {
        "light": "需要部分直射阳光，适合放置在南向窗台或阳台。上午或傍晚的柔和阳光最佳。",
        "water": "保持土壤微湿，手指插入土中 2-3 厘米感觉干燥时浇水。夏季每周 1-2 次，冬季每 10-15 天一次。",
        "temperature": "适宜生长温度18-28°C。适应性强，冬季保暖，夏季避免高温闷热。温度低于 10°C 时需采取保暖措施。",
        "humidity": "适宜空气湿度40-70%。喜欢较高湿度，干燥季节可定期喷雾增湿，或放置水盘增加局部湿度。",
        "soil": "喜欢疏松、透气、排水良好的土壤。通用营养土即可，可添加珍珠岩或蛭石改善透气性。换盆时可在盆底垫陶粒，增强排水。",
        "fertilizer": "对肥料要求不高，生长期（春夏季）每1-2周施一次稀释液肥。秋冬季减少或停止施肥。薄肥勤施，避免浓肥烧根。",
        "pruning": "及时剪除枯黄、病变的叶片和枝条。定期整理株型，保持美观。剪下的健康枝条可用于扦插繁殖。"
      }
    },
