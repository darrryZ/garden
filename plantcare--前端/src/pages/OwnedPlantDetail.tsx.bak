import { useEffect, useState, useRef } from 'react';
import { useParams, useNavigate } from 'react-router-dom';
import { ChevronLeft, Sun, Thermometer, Droplets, Plus, Check, Settings } from 'lucide-react';
import { Button } from '@/components/ui/button';
import { Badge } from '@/components/ui/badge';
import { cn } from '@/lib/utils';
import { getUserPlants, deleteUserPlant, updateUserPlant } from '@/services/userPlantService';
import { getUpcomingReminders, completeReminder } from '@/services/reminderService';
import { getDiaryEntries, createDiaryEntry } from '@/services/diaryService';
import type { OwnedPlant, Milestone } from '@/types';
import type { Reminder } from '@/services/reminderService';

export function OwnedPlantDetail() {
  const { id } = useParams<{ id: string }>();
  const navigate = useNavigate();

  const [plant, setPlant] = useState<OwnedPlant | null>(null);
  const [milestones, setMilestones] = useState<Milestone[]>([]);
  const [reminders, setReminders] = useState<Reminder[]>([]);
  const [isLoading, setIsLoading] = useState(true);
  const [notFound, setNotFound] = useState(false);

  // 里程碑输入框状态
  const [showMilestoneInput, setShowMilestoneInput] = useState(false);
  const [milestoneTitle, setMilestoneTitle] = useState('');
  const [milestoneContent, setMilestoneContent] = useState('');

  // 修改名称弹窗状态
  const [showEditNameModal, setShowEditNameModal] = useState(false);
  const [newNickname, setNewNickname] = useState('');
  const [isSavingName, setIsSavingName] = useState(false);

  // 今日任务面板状态
  const [isTaskExpanded, setIsTaskExpanded] = useState(false);
  const [isDragging, setIsDragging] = useState(false);
  const [currentHeight, setCurrentHeight] = useState(60);
  const taskPanelRef = useRef<HTMLDivElement>(null);
  const startYRef = useRef(0);
  const startHeightRef = useRef(60);

  const MIN_HEIGHT = 60; // 收起状态高度 - 只显示头部
  const MAX_HEIGHT = 320; // 展开状态高度
  const EXPANDED_THRESHOLD = 150; // 超过此高度视为展开

  useEffect(() => {
    if (!id) return;
    async function load() {
      setIsLoading(true);
      const [plants, entries, upcoming] = await Promise.all([
        getUserPlants(),
        getDiaryEntries(id!),
        getUpcomingReminders(),
      ]);
      const found = plants.find(p => p.id === id);
      if (!found) {
        setNotFound(true);
      } else {
        setPlant(found);
        setMilestones(entries);
        // 只显示属于该植物的提醒
        setReminders(upcoming.filter(r => r.userPlantId === id));
      }
      setIsLoading(false);
    }
    load();
  }, [id]);

  async function handleCompleteReminder(reminderId: string) {
    const ok = await completeReminder(reminderId);
    if (ok) {
      setReminders(prev => prev.filter(r => r.id !== reminderId));
    }
  }

  async function handleAddMilestone() {
    if (!id || !milestoneTitle.trim()) return;
    const ok = await createDiaryEntry({
      userPlantId: id,
      title: milestoneTitle.trim(),
      content: milestoneContent.trim(),
    });
    if (ok) {
      setMilestoneTitle('');
      setMilestoneContent('');
      setShowMilestoneInput(false);
      const entries = await getDiaryEntries(id);
      setMilestones(entries);
    }
  }

  async function handleDelete() {
    if (!id) return;
    const confirmed = window.confirm('确定要宣布这株植物死亡吗？此操作不可撤销。');
    if (!confirmed) return;
    const ok = await deleteUserPlant(id);
    if (ok) {
      navigate('/garden');
    }
  }

  // 触摸/鼠标事件处理
  const handleTouchStart = (e: React.TouchEvent | React.MouseEvent) => {
    setIsDragging(true);
    const clientY = 'touches' in e ? e.touches[0].clientY : e.clientY;
    startYRef.current = clientY;
    startHeightRef.current = currentHeight;
  };

  const handleTouchMove = (e: React.TouchEvent | React.MouseEvent) => {
    if (!isDragging) return;
    const clientY = 'touches' in e ? e.touches[0].clientY : e.clientY;
    const delta = startYRef.current - clientY;
    const newHeight = Math.max(MIN_HEIGHT, Math.min(MAX_HEIGHT, startHeightRef.current + delta));
    setCurrentHeight(newHeight);
  };

  const handleTouchEnd = () => {
    setIsDragging(false);
    // 使用 ref 获取最新高度值
    const finalHeight = currentHeight;
    if (finalHeight > EXPANDED_THRESHOLD) {
      setIsTaskExpanded(true);
      setCurrentHeight(MAX_HEIGHT);
    } else {
      setIsTaskExpanded(false);
      setCurrentHeight(MIN_HEIGHT);
    }
  };

  // 切换展开/收起
  const toggleTaskExpand = () => {
    if (isTaskExpanded) {
      setIsTaskExpanded(false);
      setCurrentHeight(MIN_HEIGHT);
    } else {
      setIsTaskExpanded(true);
      setCurrentHeight(MAX_HEIGHT);
    }
  };

  // 修改植物名称（只修改页面标题，不修改简介中的名称）
  const handleSaveNickname = async () => {
    if (!id || !newNickname.trim()) return;
    setIsSavingName(true);
    const success = await updateUserPlant(id, { nickname: newNickname.trim() });
    if (success) {
      // 只更新页面标题显示的名称，保留原始植物名称用于简介展示
      setPlant(prev => prev ? { ...prev, nickname: newNickname.trim() } : null);
      setShowEditNameModal(false);
    }
    setIsSavingName(false);
  };

  if (isLoading) {
    return (
      <div className="flex items-center justify-center min-h-screen">
        <p className="text-gray-400">加载中...</p>
      </div>
    );
  }

  if (notFound || !plant) {
    return (
      <div className="flex flex-col items-center justify-center min-h-screen gap-4">
        <p className="text-gray-500">植物未找到</p>
        <Button onClick={() => navigate('/garden')}>返回花园</Button>
      </div>
    );
  }

  return (
    <div className="bg-white" style={{ paddingBottom: '80px' }}>
      <header className="flex justify-between items-center p-6 sticky top-0 bg-white/80 backdrop-blur z-10">
        <button onClick={() => navigate(-1)} className="p-2 -ml-2">
          <ChevronLeft size={28} />
        </button>
        <h1 className="text-lg font-bold">{plant.nickname}</h1>
        <button 
          onClick={() => {
            setNewNickname(plant?.nickname || '');
            setShowEditNameModal(true);
          }}
          className="p-2 -mr-2 text-gray-400 hover:text-gray-600 transition-colors"
        >
          <Settings size={20} />
        </button>
      </header>

      <div className="px-6">
        <div className="flex gap-6 mb-8">
          <div className="w-1/2 aspect-square">
            <img
              src={plant.image}
              alt={plant.name}
              className="w-full h-full object-contain"
              referrerPolicy="no-referrer"
            />
          </div>
          <div className="w-1/2 pt-4">
            <h2 className="text-2xl font-bold mb-1">{plant.name}</h2>
            <p className="text-xs text-gray-400 mb-2">{plant.addedDate}</p>
            <div className="grid grid-cols-3 gap-2 mb-3">
              <div className="flex flex-col gap-0.5">
                <span className="text-[9px] text-gray-400 uppercase tracking-wider">分类</span>
                <span className="text-[10px] font-medium">{plant.originalCategory === 'foliage' ? '观叶植物' :
                  plant.originalCategory === 'flowering' ? '观花植物' :
                  plant.originalCategory === 'succulent' ? '多肉植物' :
                  plant.originalCategory === 'herbaceous' ? '草本植物' :
                  plant.originalCategory === 'vine' ? '藤蔓植物' :
                  plant.originalCategory === 'woody' ? '木本植物' : '植物'}</span>
              </div>
              <div className="flex flex-col gap-0.5">
                <span className="text-[9px] text-gray-400 uppercase tracking-wider">科属</span>
                <span className="text-[10px] font-medium">{plant.family || '-'}</span>
              </div>
              <div className="flex flex-col gap-0.5">
                <span className="text-[9px] text-gray-400 uppercase tracking-wider">难度</span>
                <span className="text-[10px] font-medium">{'⭐'.repeat(plant.difficultyLevel || 3)}</span>
              </div>
            </div>
            <Badge className="bg-primary hover:bg-primary text-white border-none rounded-lg px-4 py-1 mb-2">
              健康
            </Badge>
            <button className="text-[10px] text-gray-400 flex items-center gap-1">
              养护技巧 <ChevronLeft size={10} className="rotate-180" />
            </button>
          </div>
        </div>

        <div className="grid grid-cols-3 gap-4 mb-8">
          <div className="bg-orange-50 rounded-2xl p-3 flex flex-col items-center gap-1">
            <Sun size={18} className="text-orange-400" />
            <span className="text-[10px] font-bold">光照</span>
            <span className="text-[8px] text-gray-400">{plant.light || '喜欢阳光'}</span>
          </div>
          <div className="bg-red-50 rounded-2xl p-3 flex flex-col items-center gap-1">
            <Thermometer size={18} className="text-red-400" />
            <span className="text-[10px] font-bold">温度</span>
            <span className="text-[8px] text-gray-400">{plant.temperature || '18°C - 25°C'}</span>
          </div>
          <div className="bg-blue-50 rounded-2xl p-3 flex flex-col items-center gap-1">
            <Droplets size={18} className="text-blue-400" />
            <span className="text-[10px] font-bold">湿度</span>
            <span className="text-[8px] text-gray-400">{plant.humidity || '非常喜喝水'}</span>
          </div>
        </div>

        <section className="mb-8">
          <div className="flex justify-between items-center mb-4">
            <div className="flex items-center gap-2">
              <div className="w-6 h-6 bg-green-200 rounded-lg" />
              <h3 className="font-bold">养护日历</h3>
            </div>
            <button className="text-xs text-gray-400">查看全部</button>
          </div>
          <div className="bg-white border border-gray-100 rounded-3xl p-6 shadow-sm">
            <div className="grid grid-cols-7 gap-2">
              {Array.from({ length: 21 }).map((_, i) => (
                <div key={i} className="aspect-square rounded-full border border-gray-100 flex items-center justify-center text-[10px]">
                  {i === 9 ? '💧' : i === 15 ? '☁️' : i === 18 ? '☀️' : i === 19 ? '💧' : ''}
                </div>
              ))}
            </div>
          </div>
        </section>

        <section className="mb-8">
          <div className="flex justify-between items-center mb-6">
            <div className="flex items-center gap-2">
              <div className="w-6 h-6 bg-green-200 rounded-lg" />
              <h3 className="font-bold">里程碑</h3>
            </div>
            <button className="text-xs text-gray-400">icon保存</button>
          </div>

          {/* 分支式时间线 */}
          <div className="relative">
            {/* 中央主干线 */}
            <div className="absolute left-1/2 top-0 bottom-0 w-0.5 bg-green-200 -translate-x-1/2" />
            
            {/* 里程碑列表 */}
            <div className="space-y-8">
              {milestones.slice().reverse().map((m, i) => (
                <div key={m.id} className="relative flex items-center">
                  {/* 左侧内容 */}
                  <div className={cn("flex-1 pr-6", m.isLeft ? "visible" : "invisible")}>
                    {m.isLeft && (
                      <div className="bg-white rounded-2xl p-4 shadow-sm border border-gray-100">
                        <div className="flex items-center gap-2 mb-2">
                          <span className="text-[10px] text-green-600 bg-green-50 px-2 py-0.5 rounded-full">{m.date}</span>
                          <h4 className="font-bold text-sm">{m.title}</h4>
                        </div>
                        {m.description && (
                          <p className="text-xs text-gray-500 mb-2 line-clamp-2">{m.description}</p>
                        )}
                        {/* 图片展示 */}
                        {m.photos && m.photos.length > 0 ? (
                          <div className={cn(
                            "grid gap-1 rounded-xl overflow-hidden",
                            m.photos.length === 1 ? "grid-cols-1 aspect-video" :
                            m.photos.length === 2 ? "grid-cols-2 aspect-[2/1]" :
                            "grid-cols-3 aspect-[3/1]"
                          )}>
                            {m.photos.slice(0, 3).map((photo, idx) => (
                              <img 
                                key={idx} 
                                src={photo} 
                                alt={`photo-${idx}`}
                                className="w-full h-full object-cover"
                              />
                            ))}
                          </div>
                        ) : (
                          <div className="aspect-video bg-gradient-to-br from-green-50 to-blue-50 rounded-xl flex items-center justify-center">
                            <span className="text-2xl">
                              {m.mood === 'happy' ? '🌱' : 
                               m.mood === 'sad' ? '🥀' : 
                               m.mood === 'excited' ? '🌸' : 
                               m.mood === 'tired' ? '🍃' : '🌿'}
                            </span>
                          </div>
                        )}
                      </div>
                    )}
                  </div>
                  
                  {/* 中央节点 */}
                  <div className="relative z-10 w-4 h-4 rounded-full bg-white border-2 border-green-400 flex-shrink-0" />
                  
                  {/* 右侧内容 */}
                  <div className={cn("flex-1 pl-6", !m.isLeft ? "visible" : "invisible")}>
                    {!m.isLeft && (
                      <div className="bg-white rounded-2xl p-4 shadow-sm border border-gray-100">
                        <div className="flex items-center gap-2 mb-2">
                          <span className="text-[10px] text-green-600 bg-green-50 px-2 py-0.5 rounded-full">{m.date}</span>
                          <h4 className="font-bold text-sm">{m.title}</h4>
                        </div>
                        {m.description && (
                          <p className="text-xs text-gray-500 mb-2 line-clamp-2">{m.description}</p>
                        )}
                        {/* 图片展示 */}
                        {m.photos && m.photos.length > 0 ? (
                          <div className={cn(
                            "grid gap-1 rounded-xl overflow-hidden",
                            m.photos.length === 1 ? "grid-cols-1 aspect-video" :
                            m.photos.length === 2 ? "grid-cols-2 aspect-[2/1]" :
                            "grid-cols-3 aspect-[3/1]"
                          )}>
                            {m.phot

        <Button
          variant="destructive"
          className="w-full py-8 rounded-2xl font-bold text-lg mb-8"
          onClick={handleDelete}
        >
          宣布死亡
        </Button>
      </div>

      {/* 可上拉的今日任务面板 - 固定在底部 */}
      <div
        ref={taskPanelRef}
        className={`fixed bottom-0 left-1/2 -translate-x-1/2 w-full max-w-md bg-gradient-to-br from-teal-400 to-green-300 rounded-t-[30px] z-[100] transition-all duration-300 ${
          isDragging ? 'transition-none' : ''
        }`}
        style={{
          height: isDragging ? `${currentHeight}px` : (isTaskExpanded ? '320px' : '60px'),
          boxShadow: '0 -4px 20px rgba(0,0,0,0.1)'
        }}
      >
        {/* 拖动条 - 顶部横线 */}
        <div
          className="flex justify-center pt-3 pb-2 cursor-pointer select-none"
          onClick={toggleTaskExpand}
          onTouchStart={handleTouchStart}
          onTouchMove={handleTouchMove}
          onTouchEnd={handleTouchEnd}
          onMouseDown={handleTouchStart}
          onMouseMove={handleTouchMove}
          onMouseUp={handleTouchEnd}
          onMouseLeave={handleTouchEnd}
        >
          <div className="w-16 h-1.5 bg-white/60 rounded-full"></div>
        </div>

        {/* 头部 */}
        <div className="flex justify-between items-center px-6 pb-3">
          <h3 className="text-lg font-bold text-white">今日任务</h3>
          {reminders.length > 0 && (
            <button 
              onClick={() => {/* 一键完成所有任务 */}}
              className="text-sm text-white/90 hover:text-white transition-colors"
            >
              一键完成
            </button>
          )}
        </div>

        {/* 任务内容区域 */}
        <div className="px-4 overflow-y-auto" style={{ height: `${Math.max(0, currentHeight - 80)}px` }}>
          <div className="space-y-3">
            {reminders.length === 0 ? (
              <div className="text-center py-8">
                <div className="inline-flex items-center justify-center w-12 h-12 bg-white/20 rounded-full mb-3">
                  <span className="text-2xl">🎉</span>
                </div>
                <p className="text-white/90 text-sm">今日无任务</p>
                <p className="text-white/60 text-xs mt-1">植物们都被照顾得很好</p>
              </div>
            ) : (
              reminders.map((reminder) => (
                <div
                  key={reminder.id}
                  className="bg-white rounded-2xl p-4 flex justify-between items-center shadow-sm"
                >
                  <span className="font-medium text-gray-800">{reminder.title}</span>
                  <button
                    onClick={() => handleCompleteReminder(reminder.id)}
                    className="w-7 h-7 rounded-full bg-green-500 hover:bg-green-600 flex items-center justify-center text-white transition-colors"
                  >
                    <Check size={16} />
                  </button>
                </div>
              ))
            )}
          </div>
        </div>
      </div>

      {/* 修改名称弹窗 */}
      {showEditNameModal && (
        <div className="fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4">
          <div className="bg-white rounded-2xl p-6 w-full max-w-sm">
            <h3 className="text-lg font-bold mb-4">修改植物名称</h3>
            <input
              type="text"
              value={newNickname}
              onChange={(e) => setNewNickname(e.target.value)}
              placeholder="输入新名称"
              className="w-full px-4 py-3 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary"
              autoFocus
            />
            <div className="flex gap-3 mt-6">
              <Button
                variant="outline"
                className="flex-1"
                onClick={() => setShowEditNameModal(false)}
              >
                取消
              </Button>
              <Button
                className="flex-1 bg-primary hover:bg-primary/90"
                onClick={handleSaveNickname}
                disabled={isSavingName || !newNickname.trim()}
              >
                {isSavingName ? '保存中...' : '保存'}
              </Button>
            </div>
          </div>
        </div>
      )}
    </div>
  );
}
